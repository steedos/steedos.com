---
import type { Video } from '../lib/videos';
import { videoTitle } from '../lib/videos';

interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<div class="player">
  <video
    controls
    playsinline
    preload="none"
    poster={video.thumb_image ?? undefined}
    data-hls={video.hls_url ?? undefined}
    aria-label={videoTitle(video)}>
    {video.download_url && <source src={video.download_url} type="video/mp4" />}
  </video>
</div>

<script>
  // Safari plays HLS natively; elsewhere attach hls.js, loaded only when needed.
  document.querySelectorAll<HTMLVideoElement>('video[data-hls]').forEach(async (el) => {
    const src = el.dataset.hls!;
    if (el.canPlayType('application/vnd.apple.mpegurl')) {
      el.src = src;
      return;
    }
    const { default: Hls } = await import('hls.js');
    if (!Hls.isSupported()) return; // keep the mp4 <source> fallback
    const hls = new Hls();
    hls.loadSource(src);
    hls.attachMedia(el);
  });
</script>

<style>
  .player {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }
</style>
