---
import Base from '../layouts/Base.astro';
import { pageTitle } from '../lib/site';
---

<Base title={pageTitle('页面不存在')} noindex>
  <div class="notfound">
    <span class="code">404</span>
    <h1>页面不存在</h1>
    <p>您访问的页面可能已被移动或删除。</p>
    <div class="links">
      <a href="/">返回首页</a>
      <a href="/resources/solutions">解决方案</a>
      <a href="/resources/customer-success-stories">客户案例</a>
      <a href="/company/contact-us">联系我们</a>
    </div>
  </div>
</Base>

<style>
  .notfound {
    max-width: 36rem;
    margin: 3rem auto;
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 700;
  }
  h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    margin: 0.5rem 0;
  }
  p {
    color: var(--ink-soft);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.5rem;
  }
</style>
